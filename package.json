{
  "name": "rollcall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rollcall/api --filter @rollcall/web dev",
    "build": "pnpm --filter @rollcall/web build",
    "start": "pnpm --filter @rollcall/api start",
    "vitals:setup": "npm install --prefix apps/vitals-worker/runtime --no-audit --no-fund",
    "sessions:gen": "tsx tools/seed/gen-sessions.ts",
    "assets:forge": "tsx tools/asset-forge/forge.ts",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @rollcall/web test:e2e",
    "assets:brand": "tsx tools/asset-forge/brand.ts",
    "poses:gen": "tsx tools/seed/gen-poses.ts",
    "videos:report": "tsx tools/seed/report-videos.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
