{
  "name": "hush",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @hush/game dev",
    "judge": "pnpm --filter @hush/game dev --open \"/?judge=1\"",
    "build": "pnpm --filter @hush/game build",
    "sidecar": "pnpm --filter @hush/sidecar start",
    "sidecar:setup": "npm install --prefix apps/sidecar/runtime --no-audit --no-fund",
    "sessions:gen": "tsx tools/gen-sessions.ts",
    "assets:pack": "python tools/pack_assets.py",
    "voice:gen": "tsx tools/gen-voice.ts",
    "typecheck": "tsc -b --pretty && pnpm --filter @hush/game typecheck && pnpm --filter @hush/sidecar typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @hush/game test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
