# Presage SmartSpectra key, only needed for live check-ins.
# Register at https://physiology.presagetech.com/auth/register, then copy it from the portal.
SMARTSPECTRA_API_KEY=

# Coach sign-in, and the secret that signs the coach's cookie.
COACH_PASSPHRASE=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# OpenAI: message drafts and the asset forge. Without a key, drafts use templates.
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
ASSET_MAX_USD=2

# Optional local drafts through Ollama, used instead of OpenAI when set.
OLLAMA_URL=
OLLAMA_MODEL=

# Optional Web Push. Create a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional email notifications through Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Server
PORT=8787
DATABASE_URL=file:./rollcall.db
MAX_LIVE_SESSIONS=2
