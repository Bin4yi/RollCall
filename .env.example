# Presage SmartSpectra key. Only needed for Live mode.
# Register at https://physiology.presagetech.com/auth/register, then copy it from the portal.
SMARTSPECTRA_API_KEY=

# Sidecar input: "frames" (browser pushes webcam frames; works with built-in webcams)
# or "camera" (SDK opens the camera; on Windows this needs an external USB webcam).
HUSH_INPUT=frames

# Only for `pnpm voice:gen`, which renders the Listener's lines to audio files once.
# The game itself never uses this key. Without clips it falls back to Web Speech.
OPENAI_API_KEY=

# Meta Model API, for the asset forge (tools/hush_asset_forge.py). Create one at dev.meta.ai.
# Images only: Meta's API has no text-to-speech.
MODEL_API_KEY=
