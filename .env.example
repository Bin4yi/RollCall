# Presage SmartSpectra key, from https://physiology.presagetech.com. Only needed for Live mode.
SMARTSPECTRA_API_KEY=

# Sidecar input: "frames" (browser pushes webcam frames; works with built-in webcams)
# or "camera" (SDK opens the camera; on Windows this needs an external USB webcam).
HUSH_INPUT=frames

# Optional: higher quality whisper voice. Web Speech is used when unset.
ELEVENLABS_API_KEY=

# Asset forge (tools/hush_asset_forge.py)
MODEL_API_KEY=
